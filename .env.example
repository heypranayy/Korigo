# Public WordPress / WooCommerce Store URL
NEXT_PUBLIC_WORDPRESS_URL=https://backend-korigo.sampledomain.online
WORDPRESS_URL=https://backend-korigo.sampledomain.online

# Privileged Server-Side WordPress Admin / Application Password
# (Required for media uploads and WordPress Posts/Pages migration)
WORDPRESS_ADMIN_USER=admin
WORDPRESS_APPLICATION_PASSWORD=

# Privileged Server-Side WooCommerce REST API v3 Credentials
# (Generated under WooCommerce > Settings > Advanced > REST API)
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
